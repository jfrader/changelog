{
  "name": "@jfrader/changelog",
  "version": "1.1.2",
  "packageManager": "npm@11.18.0",
  "description": "Zero-dependency changelog system: markdown entries, an agent-facing MD workflow, a build that emits CHANGELOG.md + JSON, and a self-contained end-user page served by a tiny backend.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "jfrader",
    "email": "jfrader@pm.me",
    "url": "https://github.com/jfrader"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrader/changelog.git"
  },
  "homepage": "https://github.com/jfrader/changelog#readme",
  "bugs": {
    "url": "https://github.com/jfrader/changelog/issues"
  },
  "keywords": [
    "changelog",
    "release-notes",
    "whats-new",
    "markdown",
    "cli",
    "frontmatter",
    "release"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "changelog": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --watch --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepublish": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
